      },
      "curves": [
        {
          "channel": "facial_unit",
          "body_part": "face",
          "controller_ref": "pending:D5/face/hesitant",
          "mapping_status": "pending_D5",
          "execution_status": "unsupported",
          "unsupported_reason": "D5 controller registry not available",
          "unit": "normalized",
          "phases": {
            "start_tick": 0,
            "anticipation_end_tick": 60,
            "arrival_end_tick": 180,
            "hold_end_tick": 420,
            "end_tick": 600
          },
          "timing": "twos",
          "interpolation": "linear",
          "owner": {
            "kind": "director",
            "id": "fixture-director",
            "authorization_ref": "fixture-only-not-run-authorization"
          },
          "keyframes": [
            {
              "tick": 0,
              "value": 0
            },
            {
              "tick": 180,
              "value": 0.65
            },
            {
              "tick": 420,
              "value": 0.65
            },
            {
              "tick": 600,
              "value": 0
            }
          ]
        }
      ],
      "unsupported": [
        {
          "path": "/curves/mouth",
          "reason": "no actual audio/alignment"
        },
        {
          "path": "/curves",
          "reason": "D5 controller mapping pending; not executed"
        }
      ]
    },
